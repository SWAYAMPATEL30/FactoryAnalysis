# ── Google Gemini API (required) ───────────────────────────────────────────────
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Model to use. gemini-2.0-flash has 1,500 req/day on the free tier.
# Options: gemini-2.0-flash | gemini-2.5-flash | gemini-flash-latest
GEMINI_MODEL=gemini-2.0-flash

# ── Vertex AI (optional, production / enterprise path) ────────────────────────
# Only needed if you want GCP VPC-SC / CMEK / data residency.
# Leave GEMINI_USE_VERTEX=false (default) to use the free AI Studio API.
GEMINI_USE_VERTEX=false
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
